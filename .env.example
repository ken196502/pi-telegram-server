# Single bot used by setup.sh and scripts/start.sh.
# Replace the token, inbound token and user ID; setup.sh generates this file
# for you and writes it with mode 600.
TELEGRAM_BOTS=main=123456:replace-with-token-from-botfather
TELEGRAM_BOT_MAIN_INBOUND_TOKEN=replace-with-a-long-random-token
WEBHOOK_TOKEN=replace-with-a-long-random-token
TELEGRAM_BOT_MAIN_ALLOWED_SENDERS=123456789
TELEGRAM_TO=123456789

# Polling is the setup default and needs no public URL. Set TELEGRAM_WEBHOOK_URL
# instead to register a Telegram webhook.
TELEGRAM_POLLING=true
# TELEGRAM_WEBHOOK_URL=https://bot.example.com/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=optional-secret-header-value
# TELEGRAM_WEBHOOK_PATH=/telegram/webhook

TELEGRAM_HOST=127.0.0.1
TELEGRAM_PORT=3093

# Optional overrides.
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# PI_TELEGRAM_BOT=main
# PI_TG_TMUX_SS=pi
# PI_TG_TYPING_IDLE_MS=120000
# TELEGRAM_DEBUG_TYPING=0
# HTTPS_PROXY=http://proxy.example.com:8080
