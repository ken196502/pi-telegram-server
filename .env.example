TELEGRAM_BOT_TOKEN=123456:replace-with-token-from-botfather
WEBHOOK_TOKEN=replace-with-a-long-random-token
# Run several bots from one gateway. Names are lowercase and used in webhook paths.
# TELEGRAM_BOTS=alpha=123456:token-for-alpha,beta=654321:token-for-beta
# Per-bot overrides (replace NAME with the bot name, uppercased, non-alphanumerics as "_"):
# TELEGRAM_BOT_ALPHA_WEBHOOK_PATH=/telegram/webhook/alpha
# TELEGRAM_BOT_ALPHA_WEBHOOK_SECRET=alpha-secret
# TELEGRAM_BOT_ALPHA_INBOUND_URL=http://127.0.0.1:3094/telegram/inbound
# TELEGRAM_BOT_ALPHA_INBOUND_TOKEN=replace-with-alpha-inbound-token
# TELEGRAM_BOT_ALPHA_ALLOWED_SENDERS=123456789
# TELEGRAM_BOT_ALPHA_PARSE_MODE=HTML
# TELEGRAM_BOT_ALPHA_MESSAGE_LIMIT=3900
# TELEGRAM_BOT_ALPHA_POLLING=false
# TELEGRAM_BOT_ALPHA_API_BASE_URL=https://api.telegram.org
# Bot used by the Pi extension / CLI. Required when several bots are configured;
# without it the extension and the gateway reject outbound messages instead of
# falling back to the first bot.
# PI_TELEGRAM_BOT=alpha
# Optional API endpoint override (useful with a proxy or Telegram-compatible gateway).
# TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_HOST=127.0.0.1
TELEGRAM_PORT=3093
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
# Public HTTPS URL; when set, startup calls Telegram setWebhook (no polling is used).
# TELEGRAM_WEBHOOK_URL=https://bot.example.com/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=optional-secret-header-value
TELEGRAM_INBOUND_URL=http://127.0.0.1:3094/telegram/inbound
INBOUND_WEBHOOK_TOKEN=replace-with-pi-inbound-token
TELEGRAM_INBOUND_ALLOWED_SENDERS=123456789

# tmux session the Pi extension sends commands and menu keys to.
# Defaults to the session Pi is running in (via $TMUX), then to "pi".
# Set this when Pi runs in a differently named session.
# PI_TG_TMUX_SS=pi
